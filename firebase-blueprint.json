{
  "entities": {
    "SensorData": {
      "title": "Sensor Data",
      "description": "Logged data from DHT22 and HW-390 sensors",
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "description": "Temperature in Celsius from DHT22"
        },
        "humidity": {
          "type": "number",
          "description": "Humidity percentage from DHT22"
        },
        "soil": {
          "type": "number",
          "description": "Soil moisture percentage from HW-390"
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp when data was logged"
        },
        "manual": {
          "type": "boolean",
          "description": "Whether the data was manually injected"
        }
      },
      "required": ["temperature", "humidity", "soil", "timestamp"]
    },
    "LoggingSettings": {
      "title": "Logging Settings",
      "description": "Configuration for the ESP32 logging behavior",
      "type": "object",
      "properties": {
        "isLogging": {
          "type": "boolean",
          "description": "Whether the ESP32 should be logging data"
        },
        "interval": {
          "type": "integer",
          "description": "Logging interval in milliseconds"
        },
        "notificationFrequency": {
          "type": "string",
          "enum": ["minute", "hour", "day"],
          "description": "How often to send risk notifications"
        },
        "retentionDays": {
          "type": "integer",
          "description": "Number of days to keep logs"
        },
        "lastUpdated": {
          "type": "integer",
          "description": "Last time settings were changed"
        }
      },
      "required": ["isLogging", "interval", "notificationFrequency", "retentionDays"]
    }
  }
}

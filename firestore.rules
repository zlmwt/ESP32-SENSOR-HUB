rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidSensorData(data) {
      return data.keys().hasAll(['temperature', 'gas', 'timestamp']) &&
             data.temperature is number &&
             data.gas is number &&
             data.timestamp is timestamp;
    }

    function isValidLoggingSettings(data) {
      return data.keys().hasAll(['isLogging', 'interval']) &&
             data.isLogging is bool &&
             data.interval is int &&
             data.interval >= 1000;
    }

    // Settings collection
    match /settings/logging {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidLoggingSettings(request.resource.data);
    }

    // Sensor logs collection
    match /sensor_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidSensorData(request.resource.data);
      allow update, delete: if false; // Logs are immutable
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
